{
  "name": "nuxt-one",
  "type": "module",
  "version": "0.1.2",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "simple-git-hooks",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "commitlint": "commitlint --edit",
    "typecheck": "nuxt typecheck",
    "release": "bumpp --commit --push --tag",
    "shadcn-vue": "shadcn-vue"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.20",
    "@lucide/vue": "^1.21.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.4.0",
    "@tailwindcss/vite": "^4.3.1",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@vueuse/core": "^14.3.0",
    "better-auth": "^1.6.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.4.8",
    "pg": "^8.22.0",
    "reka-ui": "^2.10.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "trpc-nuxt": "^2.1.1",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.38",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/types": "^21.0.1",
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify/vue": "^5.0.1",
    "@nuxt/eslint": "^1.16.0",
    "@types/pg": "^8.20.0",
    "bumpp": "^11.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "lint-staged": "^17.0.8",
    "nuxi": "^3.36.0",
    "shadcn-nuxt": "^2.7.4",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.5"
  },
  "resolutions": {
    "vite": "^8.0.16"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint $1"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
