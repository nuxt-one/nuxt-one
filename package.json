{
  "name": "nuxt-one",
  "type": "module",
  "version": "0.1.1",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "simple-git-hooks",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "commitlint": "commitlint --edit",
    "typecheck": "nuxt typecheck",
    "release": "bumpp --commit --push --tag",
    "shadcn-vue": "shadcn-vue"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/i18n": "^10.2.3",
    "@tailwindcss/vite": "^4.2.1",
    "@trpc/client": "^11.10.0",
    "@trpc/server": "^11.10.0",
    "@vueuse/core": "^14.2.1",
    "better-auth": "^1.4.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-vue-next": "^0.575.0",
    "nuxt": "^4.3.1",
    "pg": "^8.18.0",
    "reka-ui": "^2.8.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "trpc-nuxt": "^2.0.1",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.29",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@commitlint/types": "^20.4.0",
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify/vue": "^5.0.0",
    "@nuxt/eslint": "^1.15.2",
    "@types/pg": "^8.16.0",
    "bumpp": "^10.4.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.0.2",
    "lint-staged": "^16.2.7",
    "nuxi": "^3.33.1",
    "shadcn-nuxt": "^2.4.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.5"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "citty": "0.2.1",
        "eslint": "10.*"
      }
    },
    "allowedDeprecatedVersions": {
      "glob": "*",
      "@esbuild-kit/core-utils": "3",
      "@esbuild-kit/esm-loader": "2",
      "node-domexception": "1",
      "unplugin-vue-router": "*"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "esbuild",
      "simple-git-hooks",
      "unrs-resolver",
      "vue-demi"
    ]
  },
  "resolutions": {
    "vite": "^7.3.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint $1"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
